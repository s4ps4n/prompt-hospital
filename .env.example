# ── Required ───────────────────────────────────────────────────
# Your domain (DNS A-record must point to this server)
DOMAIN=prompt.hospital

# Email for Let's Encrypt certificate notifications
ACME_EMAIL=admin@prompt.hospital

# ── Optional ───────────────────────────────────────────────────
# Traefik dashboard basic auth (generate with: htpasswd -nB admin)
# TRAEFIK_DASHBOARD_AUTH=admin:$$2y$$05$$...
