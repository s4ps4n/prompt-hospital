# ── Точка: по приложению на юрлицо (ООО и ИП) ─────────────────────────────
# Значения — из secrets/tochka.env; сюда только имена. _INN сервису не нужен.
TOCHKA_OOO_CLIENT_ID=
TOCHKA_OOO_CLIENT_SECRET=              # OAuth: токены через /oauth/tochka/start?key=…&org=ooo
TOCHKA_OOO_ACCOUNT_ID=                 # р/с/БИК (формат Точки); поступления на другие счета игнорируются
TOCHKA_OOO_NAME=
TOCHKA_OOO_B24_MYCOMPANY_ID=           # ID «Моей компании» ООО в Б24 — обязателен, если юрлиц два
TOCHKA_OOO_API_TOKEN=                  # опц.: JWT-ключ API вместо OAuth
TOCHKA_IP_CLIENT_ID=
TOCHKA_IP_CLIENT_SECRET=
TOCHKA_IP_ACCOUNT_ID=
TOCHKA_IP_NAME=
TOCHKA_IP_B24_MYCOMPANY_ID=
TOCHKA_IP_API_TOKEN=
# (Старая схема с одним приложением: TOCHKA_CLIENT_ID / _CLIENT_SECRET / _API_TOKEN / TOCHKA_ACCOUNTS.)
TOCHKA_REDIRECT_URL=https://it-uu.ru/oauth/tochka/callback  # как зарегистрирован в приложениях Точки
PUBLIC_WEBHOOK_URL=                    # пусто — PUBLIC_BASE_URL + WEBHOOK_PATH; этот URL отдать менеджеру Точки
# Ключ подписи вебхука (RS256): сохранённый JWK/JWKS/PEM. Не задан — JWKS Точки (кэш час).
TOCHKA_JWK_FILE=/root/orchestrator/secrets/tochka_jwk.json
TOCHKA_JWKS_URL=                       # пусто — https://enter.tochka.com/doc/openapi/static/keys/public
TOCHKA_JWT_ISS=                        # снять с первого вебхука песочницы; задан — сверяется строго
TOCHKA_JWT_AUD=                        # то же; можно списком через запятую (client_id ООО и ИП)
TOCHKA_JWT_REQUIRE_EXP=false           # true — отказ, если в токене нет exp

# ── Битрикс24: локальное приложение (НЕ входящий вебхук) ──────────────────
B24_PORTAL=https://example.bitrix24.ru
B24_CLIENT_ID=
B24_CLIENT_SECRET=
B24_TOKEN_FILE=./data/b24-tokens.json  # создаёт src/b24-auth.ts; 0600, не в git
# Только ID, снятые с портала (node src/stages.ts). Таблица стадий в ТЗ — для читателя, НЕ конфиг.
B24_ENTITY_TYPE_ID=31                  # смарт-процесс счетов (31 — «Счета»; свой — свой ID)
B24_CATEGORY_ID=                       # воронка; пусто — все воронки
B24_PAID_STAGE=                        # STATUS_ID «Оплачен» — единственная стадия, которую ставит система
B24_SEARCH_STAGES=                     # STATUS_ID через запятую — ТОЛЬКО стадии «счёт отправлен, ждём деньги»
B24_REVIEW_FIELD=                      # опц.: UF-поле-флаг «требует проверки» (да/нет)
B24_PAID_DATE_FIELD=                   # опц.: UF-поле «дата оплаты» (дата)
B24_RESPONSIBLE_ID=                    # ответственный за счета: задачи, сообщения по уровням 2–3 и сбоям
B24_TIMELINE_ENTITY_TYPE=              # опц.; по умолчанию smart_invoice / dynamic_<entityTypeId>

# ── Сервис ────────────────────────────────────────────────────────────────
AUTO_CLOSE=false                       # неделя на бою — false («только пометки»), потом true
JOURNAL_FILE=./data/journal.json       # журнал идемпотентности — единственное хранилище (90 дней)
JOURNAL_SECRET=                        # openssl rand -hex 32
RECONCILE_HOUR=7                       # ежедневная сверка, час по времени сервера
HOST=127.0.0.1
PORT=8787
WEBHOOK_PATH=/webhook/tochka
PUBLIC_BASE_URL=https://it-uu.ru
OAUTH_SETUP_KEY=                       # openssl rand -hex 24; пусто — /oauth/* и /handler выключены
